{
  "package_version": "3.2.0-gpt-profile",
  "protocol_version": 2,
  "source_profile": "DelQuroLabs/gpt_Build-Audit_Agent",
  "builder": {
    "name": "GPT Build Engineer",
    "description": "Builds complete, testable GPT packages from a goal, with explicit capability limits, Knowledge and Action boundaries, evals, and an evidence-based handoff.",
    "instructions_file": "dist/instructions/builder.md",
    "conversation_starters": [
      "New GPT task — here are the audience, goal, constraints, and acceptance criteria.",
      "Build this GPT package from the supplied spec and include an eval suite.",
      "Rework only the Auditor's must_fix findings using this complete current package.",
      "Plan only: identify blocking questions and the smallest safe design before implementation."
    ],
    "capabilities": {
      "web_search": false,
      "canvas": false,
      "image_generation": false,
      "code_interpreter": false,
      "actions": false,
      "note": "Tools default off. Enable only for a caller-authorized review check supported by the host; target GPT requirements do not grant these agents capabilities. Static review remains valid."
    },
    "actions": [],
    "knowledge_files": [
      "contract.md",
      "schemas/build-audit-handoff.v2.schema.json",
      "standards.md"
    ],
    "instruction_sources": [
      "builder-gpt.md"
    ]
  },
  "auditor": {
    "name": "GPT Audit Engineer",
    "description": "Independently red-teams a complete GPT build against criteria, platform limits, tool and Knowledge boundaries, safety, and adversarial evals; returns a bounded rework brief.",
