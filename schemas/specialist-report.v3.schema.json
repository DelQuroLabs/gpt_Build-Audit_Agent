{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delqurolabs.github.io/gpt_Build-Audit_Agent/schemas/specialist-report.v3.schema.json",
  "title": "Specialist Report v3",
  "description": "Advisory domain review that feeds the Auditor. Never a verdict. Provisional S IDs are promoted to F IDs only by the Auditor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "task_id",
    "build_revision",
    "specialist",
    "trigger_reasons",
    "summary",
    "scope_review",
    "findings",
    "non_findings",
    "open_questions",
    "recommended_to_auditor",
    "research_brief"
  ],
  "properties": {
    "contract": {
      "const": "specialist-report"
    },
    "version": {
      "const": 3
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "build_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "specialist": {
      "enum": [
        "security",
        "ux",
        "perf",
        "data",
        "release",
        "researcher"
      ]
    },
    "trigger_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scope_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_paths",
        "unavailable_context"
      ],
      "properties": {
        "reviewed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unavailable_context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "non_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_to_auditor": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^S[1-9][0-9]*$"
      }
    },
    "research_brief": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/researchBrief"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "specialist": {
            "const": "researcher"
          }
        },
        "required": [
          "specialist"
        ]
      },
      "then": {
        "properties": {
          "research_brief": {
            "$ref": "#/$defs/researchBrief"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "specialist": {
            "not": {
              "const": "researcher"
            }
          }
        },
        "required": [
          "specialist"
        ]
      },
      "then": {
        "properties": {
          "research_brief": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "file",
        "lines",
        "quote",
        "trigger",
        "expected",
        "actual",
        "impact",
        "fix",
        "evidence_basis",
        "evidence_detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "severity": {
          "enum": [
            "BLOCKER",
            "MAJOR",
            "MINOR",
            "NIT"
          ]
        },
        "category": {
          "enum": [
            "correctness",
            "security",
            "failure_handling",
            "verification_gap",
            "testing",
            "performance",
            "maintainability",
            "standards",
            "regression",
            "ux",
            "data",
            "ops",
            "other"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "lines": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": "string"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        },
        "evidence_basis": {
          "enum": [
            "runtime_reproduced",
            "static_proof",
            "provided_log"
          ]
        },
        "evidence_detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "researchBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknowns_addressed",
        "facts",
        "sources",
        "recommendations"
      ],
      "properties": {
        "unknowns_addressed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fact",
              "status",
              "source"
            ],
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "unverified"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
